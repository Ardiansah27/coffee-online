          let cspReportsCount = 0;
          document.addEventListener('securitypolicyviolation', async (event) => {
            if (event.originalPolicy.includes('report-uri') || cspReportsCount >= 500) {
              return;
            }
            cspReportsCount += 1;
            await fetch('/_/_/csp_report/', {
              method: 'POST',
              body: JSON.stringify({
                'csp-report': {
                  'blocked-uri': event.blockedURI,
                  'column-number': event.columnNumber,
                  disposition: event.disposition,
                  'document-uri': event.documentURI,
                  'effective-directive': event.effectiveDirective,
                  'line-number': event.lineNumber,
                  'original-policy': event.originalPolicy,
                  referrer: event.referrer,
                  sample: event.sample,
                  'source-file': event.sourceFile,
                  'status-code': event.statusCode,
                  'violated-directive': event.violatedDirective,
                  'is-metatag': true,
                },
              }),
            });
          });
      </script><link href="./image_files/67047-9df45f641b8e9863.css" rel="stylesheet"><link href="./image_files/AuthDesktopCSSImports-c83ca0df1727ccc4.css" rel="stylesheet"><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/runtime.id_ID-f326d40fdcf1289e.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/polyfills-206a76f5fc8a17cf.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/locale-id_ID-LocaleDataLoader-9d63e5013cd0cb9e.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/vendor-react-e001519891608c30.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/58967-bb79fb5c7b9bb6e0.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/67243-73c37aef570da49a.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/36849-8e8bd7a6ca2f5495.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/53547-dca1640440329279.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/75581.id_ID-71818b70bc64b2cb.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/41642-cd0eac5c35ae627d.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/98751.id_ID-f862eb791b781de9.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/51226-10f1dcfff93250e6.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/92911-51f1c0b0ce51de4d.mjs"></script><script crossorigin="anonymous" defer="" fetchpriority="high" nonce="" src="./image_files/85724-7edc491d64af68fa.mjs"></s